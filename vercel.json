{
  "functions": {
    "api/invoices.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/pdfkit/js/data/**"
    },
    "api/health.js": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
