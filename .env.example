NODE_ENV=development

# --- Small language model (Gemma 3 4B via Ollama-compatible API) ---
# Required only for plain-text input. Must be a reachable HTTPS endpoint on Vercel (not localhost).
# ollama-compatible (base: https://host) or openai-compatible (base: https://api.example.com/v1)
SLM_PROVIDER=ollama-compatible
SLM_BASE_URL=
SLM_MODEL=gemma3:4b
SLM_API_KEY=
SLM_TIMEOUT_MS=20000

# --- SMTP (required) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- API security (required in production) ---
API_KEY=
MAX_BODY_BYTES=102400
RATE_LIMIT_PER_MINUTE=20

# --- Shared state for rate limiting + idempotency (optional but strongly recommended on Vercel) ---
# Upstash Redis REST credentials. Without them an in-memory per-instance fallback is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- A2A discovery (optional) ---
# Public origin used in the Agent Card, e.g. https://invoice-agent.example.com. Derived from the request host when empty.
PUBLIC_BASE_URL=

# --- MCP (optional) ---
# Comma-separated browser origins allowed to call /api/mcp (same-host origins and non-browser clients are always allowed).
MCP_ALLOWED_ORIGINS=

# --- Business details printed on the invoice (optional) ---
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=

# --- Only used by `npm run test:integration` ---
# RUN_INTEGRATION=1
# INTEGRATION_TO_EMAIL=
